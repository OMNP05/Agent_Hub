# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real values and never paste them into chat.
# This file lists every setting the backend reads. Add a line here in the same change that adds a new setting.

# ---- Supabase (project reference wakaxqwiaezahfcbyiqd) ----
SUPABASE_URL=https://<project-ref>.supabase.co
# New-style publishable key (public by design, safe in the client). Format: sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Supabase dashboard -> Project Settings -> API Keys). Format: sb_secret_...
# Bypasses row-level security. Keep it in Secret Manager in production. NEVER ship it in the Android app.
SUPABASE_SECRET_KEY=

# Postgres connection. The "direct" host (db.<ref>.supabase.co) is IPv6-only on the Free plan and will not
# work from Cloud Run. Use the pooler string from the dashboard's Connect dialog instead:
#   session mode:      postgresql://postgres.<ref>:<PASSWORD>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#   transaction mode:  postgresql://postgres.<ref>:<PASSWORD>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
# Copy the exact host from the dashboard; it cannot be derived. URL-encode special characters in the password.
DATABASE_URL=

# ---- Encryption (B4) ----
# 32 random bytes, base64. Generate locally (prints a key, stores nothing):  python -m app.crypto generate-key
MASTER_ENCRYPTION_KEY=
KEY_VERSION=1
# Only during a key rotation: old keys as "<version>:<base64>,<version>:<base64>". Leave empty otherwise.
RETIRED_MASTER_KEYS=

# ---- Google (B3, B7) ----
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=

# ---- GitHub App (B7) ----
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# ---- Public addresses (B7, B12) ----
PUBLIC_BASE_URL=http://localhost:8000
APP_LINK_HOST=
# Android package and the SHA-256 fingerprint(s) of the key that signs the app (public values, comma-separated,
# for example AA:BB:...). Served at /.well-known/assetlinks.json so Android verifies the App Link.
ANDROID_PACKAGE=dev.agenthub.app
ANDROID_CERT_SHA256=

# ---- Runtime ----
ENVIRONMENT=local
LOG_LEVEL=INFO
